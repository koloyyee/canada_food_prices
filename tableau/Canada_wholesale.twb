          <datasource-dependencies datasource='federated.1b3hfxm1a0krkg1a4u9830dik95v'>
            <column caption='Top Retail Price Gainer(%)' datatype='real' default-format='p0.00%' name='[Abs Retail Price Gainer($) (copy)_0498940386144258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Retail prices from 2026 &#10;(AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2026 ) THEN [normalised_price] END )&#10;-&#10;// Retail prices from 2022 &#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2022 ) THEN [normalised_price] END ))&#10;/&#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2022 ) THEN [normalised_price] END )' />
