    <worksheet name='Volatility'>
      <table>
        <view>
          <datasources>
            <datasource caption='ontario_protein_prices' name='federated.1b3hfxm1a0krkg1a4u9830dik95v' />
          </datasources>
          <datasource-dependencies datasource='federated.1b3hfxm1a0krkg1a4u9830dik95v'>
            <column caption='Standard Deviation of the Monthly Average Prices' datatype='real' default-format='p0.00%' name='[Calculation_0498940392050693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV({ FIXED [protein], DATETRUNC(&apos;month&apos;, [month]) : AVG([normalised_price]) })&#10;&#10;// ⚬&#9;DATETRUNC(&apos;month&apos;, [Month])&#10;// Rounds every date down to its starting month (e.g., 2026-08-15 becomes 2026-08-01). This ensures pricing data groups cleanly into month-by-month buckets.&#10;// ⚬&#9;FIXED [Protein], DATETRUNC(...) : AVG([Normalised Price])&#10;// This Level of Detail (LOD) expression calculates the exact average price for a specific protein in a given month in the background dataset, regardless of what dimensions are placed on your dashboard canvas.&#10;// ⚬&#9;STDEV(...)&#10;// Takes all those monthly average values generated by the inner {FIXED} expression and calculates their standard deviation. High standard deviation indicates high price dispersion (volatility), whereas low standard deviation indicates price stability.' />
            </column>
            <column caption='Volatility' datatype='real' default-format='p0.00%' name='[Calculation_0498940394631174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV({ FIXED [protein], DATETRUNC(&apos;month&apos;, [month]) : AVG([normalised_price]) })&#10;/&#10;AVG({ FIXED [protein] : AVG([normalised_price]) })' />
            </column>
            <column caption='Month' datatype='date' datatype-customized='true' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[protein]' derivation='None' name='[none:protein:nk]' pivot='key' type='nominal' />
            <column caption='Normalised Price' datatype='real' name='[normalised_price]' role='measure' type='quantitative' />
            <column caption='Protein' datatype='string' name='[protein]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0498940394631174]' derivation='User' name='[usr:Calculation_0498940394631174:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1b3hfxm1a0krkg1a4u9830dik95v].[none:protein:nk]'>
            <groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end'>
              <groupfilter direction='DESC' expression='[Calculation_0498940392050693]' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:protein:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1b3hfxm1a0krkg1a4u9830dik95v].[none:protein:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='263' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1b3hfxm1a0krkg1a4u9830dik95v].[none:protein:nk]' />
              <text column='[federated.1b3hfxm1a0krkg1a4u9830dik95v].[usr:Calculation_0498940394631174:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontalignment='0' fontsize='12'><![CDATA[±<[federated.1b3hfxm1a0krkg1a4u9830dik95v].[usr:Calculation_0498940394631174:qk]>]]></run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontsize='12'><![CDATA[<[federated.1b3hfxm1a0krkg1a4u9830dik95v].[none:protein:nk]>]]></run>
                <run fontalignment='0' fontsize='12'> · Most Volatile Category</run>
                <run fontalignment='0'>Æ&#10;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
