      <aliases enabled='yes' />
      <column caption='Top Retail Price Gainer(%)' datatype='real' default-format='p0.00%' name='[Abs Retail Price Gainer($) (copy)_0498940386144258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Retail prices from 2026 &#10;(AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2026 ) THEN [normalised_price] END )&#10;-&#10;// Retail prices from 2022 &#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2022 ) THEN [normalised_price] END ))&#10;/&#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2022 ) THEN [normalised_price] END )' />
      </column>
      <column caption='Top Retail Price Gainer($)' datatype='real' name='[Calculation_0498940384591873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Retail prices from 2026 &#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2026 ) THEN [normalised_price] END )&#10;-&#10;// Retail prices from 2022 &#10;AVG(IF( [stage] = &apos;retail&apos; AND YEAR([month]) = 2022 ) THEN [normalised_price] END )' />
      </column>
      <column caption='Widest Spread' datatype='real' name='[Calculation_0498940390420483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Calculation_5973198862036993], [Calculation_5973198861860864])' />
      </column>
      <column caption='Standard Deviation of the Monthly Average Prices' datatype='real' default-format='p0.00%' name='[Calculation_0498940392050693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV({ FIXED [protein], DATETRUNC(&apos;month&apos;, [month]) : AVG([normalised_price]) })&#10;&#10;// ⚬&#9;DATETRUNC(&apos;month&apos;, [Month])&#10;// Rounds every date down to its starting month (e.g., 2026-08-15 becomes 2026-08-01). This ensures pricing data groups cleanly into month-by-month buckets.&#10;// ⚬&#9;FIXED [Protein], DATETRUNC(...) : AVG([Normalised Price])&#10;// This Level of Detail (LOD) expression calculates the exact average price for a specific protein in a given month in the background dataset, regardless of what dimensions are placed on your dashboard canvas.&#10;// ⚬&#9;STDEV(...)&#10;// Takes all those monthly average values generated by the inner {FIXED} expression and calculates their standard deviation. High standard deviation indicates high price dispersion (volatility), whereas low standard deviation indicates price stability.' />
      </column>
      <column caption='Volatility' datatype='real' default-format='p0.00%' name='[Calculation_0498940394631174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV({ FIXED [protein], DATETRUNC(&apos;month&apos;, [month]) : AVG([normalised_price]) })&#10;/&#10;AVG({ FIXED [protein] : AVG([normalised_price]) })' />
      </column>
      <column caption='Monthly Avg Price' datatype='real' name='[Calculation_0498940398141447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [protein], DATETRUNC(&apos;month&apos;, [month]) : AVG([normalised_price]) }' />
      </column>
      <column caption='MoM%' datatype='real' default-format='p0.00%' name='[Calculation_0498940399566856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  AVG([normalised_price]) &#10;  - LOOKUP(AVG([normalised_price]), -1)&#10;) &#10;/ LOOKUP(AVG([normalised_price]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Peak MoM Surge' datatype='real' default-format='p0.00%' name='[Calculation_0498940400369673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_0498940399566856])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' First Filter' datatype='boolean' name='[Calculation_0498940410294282]' role='measure' type='nominal'>
        <calculation class='tableau' formula='FIRST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Markup %' datatype='real' default-format='p0.00%' name='[Calculation_2295814134968320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5973198862036993]/[Calculation_5973198861860864]) - 1' />
      </column>
      <column caption='Retail YoY' datatype='real' default-format='p0.00%' name='[Calculation_2295814135824385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5973198862036993]) - LOOKUP(ZN([Calculation_5973198862036993]), -1)) / ABS(LOOKUP(ZN([Calculation_5973198862036993]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Farm prices' datatype='real' name='[Calculation_5973198861860864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if [stage]= &apos;farm&apos; then [normalised_price]END)' />
      </column>
      <column caption='Retail prices' datatype='real' name='[Calculation_5973198862036993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [stage] = &apos;retail&apos; then [normalised_price] end)' />
      </column>
      <column caption='Price spread' datatype='real' name='[Calculation_5973198862184450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5973198862036993] - [Calculation_5973198861860864]' />
      </column>
      <column caption='Price ratio' datatype='real' name='[Calculation_5973198864932867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5973198862036993]/[Calculation_5973198861860864]' />
      </column>
      <column aggregation='None' datatype='integer' name='[Normalised Price (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[normalised_price]' peg='0' size='1.42' />
      </column>
      <column caption='Farm YoY' datatype='real' default-format='p0.00%' name='[Retail YoY (copy)_2295814144278530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5973198861860864]) - LOOKUP(ZN([Calculation_5973198861860864]), -1)) / ABS(LOOKUP(ZN([Calculation_5973198861860864]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
